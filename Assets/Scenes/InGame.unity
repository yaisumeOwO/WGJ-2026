    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: butAceptar
      value: 
      objectReference: {fileID: 592410714}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: butDialogo
      value: 
      objectReference: {fileID: 842766312}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: butRechazar
      value: 
      objectReference: {fileID: 214886645}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: butWorkArea
      value: 
      objectReference: {fileID: 1951671920}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[0]'
      value: "Buen d\xEDa, quiero vender esta correa."
      objectReference: {fileID: 0}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[1]'
      value: "Era de mi perrito toby. Pero toby\u2026 ya no la ocupara, tal vez pueda
        servirle a otro perrito, a toby le gustaba mucho, cuando lo sacaba a pasear,
        siempre escog\xEDa esta correa."
      objectReference: {fileID: 0}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[2]'
      value: "Es muy c\xF3moda, f\xE1cil de poner, tiene el largo justo, es de metal,
        muy buena calidad."
      objectReference: {fileID: 0}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[3]'
      value: Lo vendo en 5 mil pesos.
      objectReference: {fileID: 0}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[4]'
      value: "Buen d\xEDa, quiero vender esta mu\xF1eca."
      objectReference: {fileID: 0}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[5]'
      value: Era de mi madre, me la paso esperando que tuviera una hija, lastima
        que eso no paso, y uno no puede regresar el tiempo.
      objectReference: {fileID: 0}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[6]'
      value: "Quisiera que una ni\xF1a pueda disfrutar de esta mu\xF1eca, la he cuidado
        por mucho tiempo,mi mam\xE1 jugaba diario, me contaba de lo maravilloso de
        tener una hija ."
      objectReference: {fileID: 0}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[7]'
      value: "Lo vendo en 10 mil pesos, porque la ropa es hecha a mano, por las manos
        de una mujer que anhelaba ser abuela de una ni\xF1a."
      objectReference: {fileID: 0}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[8]'
      value: "Buen d\xEDa, quiero vender esta moneda."
      objectReference: {fileID: 0}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[9]'
      value: "Es de mi colecci\xF3n personal de monedas \xFAnicas, existen muy pocas
        como est\xE1 en el mercado, recuerdo cuando empec\xE9 a coleccionar estas
        desde la infancia, de hecho."
      objectReference: {fileID: 0}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[10]'
      value: "Me la dio mi padre una semana antes de morir, mi cumplea\xF1os se acercaba
        y solo quer\xEDa verme sonreir."
      objectReference: {fileID: 0}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[11]'
      value: Lo vendo en 12 mil pesos.
      objectReference: {fileID: 0}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[12]'
      value: "Buen d\xEDa, quiero vender este reloj."
      objectReference: {fileID: 0}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[13]'
      value: "Le pertenec\xEDa a mi abuelo, me lo hered\xF3 como un legado familiar,
        tiene la m\xE1s alta ingenier\xEDa desarrollada incluso superando los actuales."
      objectReference: {fileID: 0}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[14]'
      value: "Sabe este reloj pas\xF3 por la familia real inglesa, huellas digitales
        impregnadas en su exterior solo por eso\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[15]'
      value: Lo vendo en 24 mil pesos.
      objectReference: {fileID: 0}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[16]'
      value: "Buen d\xEDa, quiero vender este anillo."
      objectReference: {fileID: 0}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[17]'
      value: "Tiene una piedra hermosa, es una esmeralda de 2 quilates, aparte el
        metal es oro, de lo m\xE1s caro que hay en el mercado ahorita."
      objectReference: {fileID: 0}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[18]'
      value: "Era de alguien importante para mi, pero recientemente fallecio, tuvo
        un infarto hace unas pocas semanas, verlo solo me llena de una inmensa tristeza,
        lo mejor ser\xEDa venderlo."
      objectReference: {fileID: 0}
    - target: {fileID: 6292314049376002364, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: 'dialogos.Array.data[19]'
      value: "Lo vendo en 8 mil pesos, el \xFAnico detalle es que tiene una inscripci\xF3n
        atr\xE1s, que dice te amo por siempre Marie."
      objectReference: {fileID: 0}
    - target: {fileID: 7619095539490184287, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
      propertyPath: m_Type
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 7619095539490184287, guid: ad7b8ec90bdba5243b858ce3f099e137, type: 3}
